# Copy to .env.local (next dev and scripts) or .dev.vars (Workers preview). Both are gitignored. Never commit values.

# Qloo Insights API (hackathon key). Server-side only, sent as X-Api-Key.
QLOO_API_KEY=
# Optional caps on live Qloo calls (defaults 6000 total, 1500 a day).
QLOO_CAP_TOTAL=
QLOO_CAP_DAY=

# Nebius Token Factory (NVIDIA Nemotron models and Qwen3 Embedding, OpenAI-compatible API).
NEBIUS_API_KEY=
# live (default) or replay
TF_MODE=
# Optional override of the Token Factory base URL.
TF_BASE_URL=

# Tavily event search. TAVILY_MODE=replay (or no key) turns live search off.
TAVILY_API_KEY=
TAVILY_MODE=

# Accounts: session secret, 32+ characters. Google sign-in appears only when both Google values are set.
WALLSPACE_AUTH_SECRET=
WALLSPACE_GOOGLE_CLIENT_ID=
WALLSPACE_GOOGLE_CLIENT_SECRET=

# Shared secret the NeMo Guardrails job uses on /api/ingest/nemo.
WALLSPACE_INGEST_SECRET=

# Connectors: Composio (Gmail, Outlook, HubSpot, Google Sheets, calendars) and the Slack app.
COMPOSIO_API_KEY=
WALLSPACE_COMPOSIO_WEBHOOK_SECRET=
WALLSPACE_SLACK_BOT_TOKEN=
WALLSPACE_SLACK_SIGNING_SECRET=
WALLSPACE_SLACK_CHANNEL=

# Public URL used in links the backend sends (e-mails, Slack, OAuth returns).
APP_URL=

# Storage when not on Workers: d1 | file | memory. Unset = d1 when bound, else a local file store.
STORE_DRIVER=
STORE_FILE=
# SQLite file for auth under next dev (defaults to the OS temp directory).
AUTH_DEV_DB=

# Live plan runs allowed per day (default 10).
PLAN_DAILY_CAP=

# Build time: "app" makes the UI read the real API; anything else serves the labelled sample data in src/mocks.
NEXT_PUBLIC_DATA_MODE=

# Deploy only (wrangler): Cloudflare credentials.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
